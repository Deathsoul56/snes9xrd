/* DuckStation-inspired palette, adapted for Snes9x */

QMainWindow,
QDialog {
    background-color: #1e1f25;
    color: #e8e8e8;
}

QWidget {
    color: #d8d8d8;
    background-color: transparent;
    font-family: "Inter", "Segoe UI", sans-serif;
}

/* ───── Library page ───── */
#libraryPage {
    background-color: #1e1f25;
}

#libraryHeader {
    background-color: #1a1b21;
    border-bottom: 1px solid #2a2c33;
}

#libraryTitle {
    color: #f0f0f0;
    font-size: 13pt;
    font-weight: 600;
    padding: 12px 16px;
}

#librarySearch {
    background-color: #16171c;
    border: 1px solid #2a2c33;
    border-radius: 6px;
    padding: 6px 10px;
    color: #d8d8d8;
    selection-background-color: #3a3d4a;
}

#librarySearch:focus {
    border-color: #4a90ff;
}

#libraryEmptyTitle {
    color: #d8d8d8;
    font-size: 14pt;
    font-weight: 500;
}

#libraryEmptyHint {
    color: #8a8d99;
    font-size: 10pt;
}

#libraryDropZone {
    background-color: #16171c;
    border: 2px dashed #3a3d4a;
    border-radius: 12px;
}

/* ───── Game list ───── */
QTableView#gameTable {
    background-color: #1e1f25;
    alternate-background-color: #1a1b21;
    gridline-color: #2a2c33;
    border: none;
    selection-background-color: #3a4d6e;
    selection-color: #ffffff;
    outline: 0;
}

QTableView#gameTable::item {
    padding: 6px 8px;
    border: none;
}

QTableView#gameTable::item:hover {
    background-color: #23252c;
}

QTableView#gameTable::item:selected:hover {
    background-color: #3a4d6e;
    color: #ffffff;
}

QHeaderView#gameHeader {
    background-color: #16171c;
    border: none;
}

QHeaderView#gameHeader::section {
    background-color: #16171c;
    color: #8a8d99;
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid #2a2c33;
    font-weight: 600;
    font-size: 9pt;
}

QTableCornerButton::section {
    background-color: #16171c;
    border: none;
}

/* ───── Status bar ───── */
QStatusBar {
    background-color: #16171c;
    color: #8a8d99;
    border-top: 1px solid #2a2c33;
}

QStatusBar::item {
    border: none;
}

/* ───── Settings dialog (sidebar) ───── */
#settingsSidebar {
    background-color: #16171c;
    border-right: 1px solid #2a2c33;
}

QListWidget#settingsPanelList {
    background-color: #16171c;
    border: none;
    outline: 0;
    padding: 8px 0;
}

QListWidget#settingsPanelList::item {
    color: #c8c8c8;
    padding: 10px 14px;
    border: none;
    border-radius: 6px;
    margin: 2px 8px;
}

QListWidget#settingsPanelList::item:hover {
    background-color: #23252c;
    color: #ffffff;
}

QListWidget#settingsPanelList::item:selected {
    background-color: #2a2c33;
    color: #ffffff;
}

/* ───── Generic controls ───── */
QPushButton {
    background-color: #23252c;
    border: 1px solid #2a2c33;
    border-radius: 6px;
    padding: 6px 14px;
    color: #d8d8d8;
}

QPushButton:hover {
    background-color: #2a2c33;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #1a1b21;
}

QPushButton:disabled {
    color: #555;
    background-color: #1a1b21;
    border-color: #23252c;
}

/* ───── Cheats dialog ───── */
QDialog#cheatsDialog {
    background-color: #17191f;
}

QDialog#cheatsDialog QLabel {
    color: #c8ccd7;
    font-weight: 600;
}

QDialog#cheatsDialog QLineEdit {
    background-color: #101218;
    border: 1px solid #3b414f;
    border-radius: 5px;
    padding: 7px 9px;
    color: #f3f6ff;
    selection-background-color: #3478c7;
}

QDialog#cheatsDialog QLineEdit:focus {
    border-color: #4a9cff;
    background-color: #151a24;
}

QDialog#cheatsDialog QPushButton {
    min-height: 24px;
    font-weight: 600;
}

QPushButton#cheatAddButton {
    background-color: #2867b2;
    border-color: #4a9cff;
    color: #ffffff;
}

QPushButton#cheatAddButton:hover {
    background-color: #3478c7;
}

QPushButton#cheatDatabaseButton {
    background-color: #214d78;
    border-color: #3972a8;
    color: #e7f2ff;
}

QPushButton#cheatDatabaseButton:hover {
    background-color: #2b618f;
}

QPushButton#cheatClearButton:hover {
    background-color: #3b4555;
    border-color: #8fa9c9;
    color: #ffffff;
}

QPushButton#cheatRemoveButton:hover,
QPushButton#cheatRemoveAllButton:hover {
    background-color: #582c34;
    border-color: #a84c59;
    color: #ffffff;
}

QDialog#cheatsDialog QTreeWidget {
    background-color: #101218;
    alternate-background-color: #171c26;
    border: 1px solid #3b414f;
    color: #ecf0f8;
    outline: 0;
}

QDialog#cheatsDialog QTreeWidget::item {
    padding: 4px 6px;
}

QDialog#cheatsDialog QTreeWidget::item:hover {
    background-color: #202a3a;
}

QDialog#cheatsDialog QTreeWidget::item:selected {
    background-color: #2867b2;
    color: #ffffff;
}

QDialog#cheatsDialog QHeaderView::section {
    background-color: #242a35;
    border: none;
    border-bottom: 1px solid #4a5364;
    color: #b9d5ff;
    padding: 6px;
    font-weight: 700;
}

QDialog#cheatsDialog QTreeWidget::indicator {
    width: 16px;
    height: 16px;
}

QDialog#cheatsDialog QTreeWidget::indicator:unchecked {
    background-color: #11151d;
    border: 1px solid #67748a;
    border-radius: 3px;
}

QDialog#cheatsDialog QTreeWidget::indicator:checked {
    background-color: #3c91e6;
    border: 1px solid #83c0ff;
    border-radius: 3px;
}

/* Small circular "clear this row's binding" button at the end of each
   binding-table row (ControllerPanel/ShortcutsPanel). The extra bottom
   padding compensates for the "−" glyph sitting at font x-height instead of
   true vertical-center, which otherwise makes it look like an underscore. */
QPushButton#clearBindingButton {
    padding: 0px 0px 3px 0px;
    border-radius: 11px;
    font-weight: bold;
    font-size: 14px;
}

QPushButton#clearBindingButton:hover {
    background-color: #4a2020;
    border-color: #6a2a2a;
    color: #ffffff;
}

QPushButton#clearBindingButton:pressed {
    background-color: #6a2a2a;
}

/* Small circular "reset this row to its default binding" button, next to
   the clear button on the Shortcuts table. */
QPushButton#resetBindingButton {
    padding: 0px 0px 2px 0px;
    border-radius: 11px;
    font-size: 13px;
}

QPushButton#resetBindingButton:hover {
    background-color: #204a3a;
    border-color: #2a6a52;
    color: #ffffff;
}

QPushButton#resetBindingButton:pressed {
    background-color: #2a6a52;
}

QToolTip {
    background-color: #16171c;
    color: #d8d8d8;
    border: 1px solid #2a2c33;
    padding: 4px 8px;
}

QScrollBar:vertical {
    background-color: #1a1b21;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #3a3d4a;
    border-radius: 4px;
    min-height: 30px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: #4a4d5a;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    background: none;
    height: 0;
}

QMenu {
    background-color: #16171c;
    border: 1px solid #2a2c33;
    color: #d8d8d8;
    padding: 4px;
}

QMenu::item {
    padding: 6px 22px;
    border-radius: 4px;
}

QMenu::indicator {
    subcontrol-position: right center;
    subcontrol-origin: padding;
    right: 8px;
}

QMenu::indicator:checked {
    image: url(:/icons/whiteicons/check.svg);
    width: 16px;
    height: 16px;
}

QMenu::item:disabled {
    color: #555;
}

QMenu::item:selected {
    background-color: #2a2c33;
}

QMenu::separator {
    height: 1px;
    margin: 4px 6px;
    background-color: #454852;
}

QMenuBar {
    background-color: #16171c;
    color: #d8d8d8;
    border-bottom: 1px solid #2a2c33;
}

QMenuBar::item {
    padding: 6px 12px;
    background: transparent;
}

QMenuBar::item:selected {
    background-color: #2a2c33;
}

/* ───── Settings panel controls ───── */
QGroupBox {
    color: #f0f0f0;
    border: 1px solid #2a2c33;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 4px;
    color: #f0f0f0;
}

QCheckBox {
    color: #d8d8d8;
    spacing: 8px;
}

QCheckBox:disabled {
    color: #555;
    font-style: italic;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #4a4d5a;
    border-radius: 3px;
    background-color: #16171c;
}

QCheckBox::indicator:hover {
    border-color: #4a90ff;
}

QCheckBox::indicator:checked {
    background-color: #4a90ff;
    border-color: #4a90ff;
}

QCheckBox::indicator:disabled {
    border-color: #2a2c33;
    background-color: #1a1b21;
}

QComboBox {
    background-color: #23252c;
    border: 1px solid #4a4d5a;
    border-radius: 6px;
    padding: 4px 8px;
    color: #d8d8d8;
}

QComboBox:hover {
    border-color: #4a90ff;
}

QComboBox:disabled {
    color: #555;
    background-color: #1a1b21;
    border-color: #23252c;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: #16171c;
    border: 1px solid #2a2c33;
    color: #d8d8d8;
    selection-background-color: #2a2c33;
    selection-color: #ffffff;
    outline: none;
}

QLineEdit,
QSpinBox,
QDoubleSpinBox {
    background-color: #23252c;
    border: 1px solid #4a4d5a;
    border-radius: 6px;
    padding: 4px 8px;
    color: #d8d8d8;
}

QLineEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: #4a90ff;
}

QLineEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    color: #555;
    background-color: #1a1b21;
    border-color: #23252c;
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    width: 18px;
    background-color: #343844;
    border-left: 1px solid #5a6070;
    subcontrol-origin: border;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 6px;
    border-bottom: 1px solid #5a6070;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 6px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: #4a5d7e;
}

QSpinBox::up-button:pressed,
QSpinBox::down-button:pressed,
QDoubleSpinBox::up-button:pressed,
QDoubleSpinBox::down-button:pressed {
    background-color: #4a90ff;
}

QSpinBox::up-button:disabled,
QSpinBox::down-button:disabled,
QDoubleSpinBox::up-button:disabled,
QDoubleSpinBox::down-button:disabled {
    background-color: #23252c;
    border-left-color: #2c2e36;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid #d8d8d8;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #d8d8d8;
}

QSpinBox::up-arrow:disabled,
QSpinBox::up-arrow:off,
QDoubleSpinBox::up-arrow:disabled,
QDoubleSpinBox::up-arrow:off {
    border-bottom-color: #555;
}

QSpinBox::down-arrow:disabled,
QSpinBox::down-arrow:off,
QDoubleSpinBox::down-arrow:disabled,
QDoubleSpinBox::down-arrow:off {
    border-top-color: #555;
}

QSlider::groove:horizontal {
    background-color: #1a1b21;
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: #4a90ff;
    width: 14px;
    height: 14px;
    margin: -6px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background-color: #6aa6ff;
}

QSlider::sub-page:horizontal {
    background-color: #3a4d6e;
    border-radius: 2px;
}
