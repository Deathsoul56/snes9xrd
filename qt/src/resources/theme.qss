/* Base stylesheet template for Snes9x's themes. @TOKEN@ placeholders are
   substituted per-theme at runtime by EmuTheme::apply(). */

/* QDialog/QMainWindow are QWidget subclasses, so this rule must come AFTER
   the generic QWidget rule below -- equal-specificity selectors resolve by
   source order in Qt style sheets, and the generic rule's transparent
   background would otherwise win and blank out every dialog/window. */
QWidget {
    color: @TEXT@;
    background-color: transparent;
    font-family: "Inter", "Segoe UI", sans-serif;
}

QMainWindow,
QDialog {
    background-color: @BG_WINDOW@;
    color: @TEXT@;
}

/* The generic QWidget rule above makes bare container widgets transparent,
   which lets multi-layer compositing (e.g. QStackedWidget pages inside the
   Settings dialog) fall through to black instead of the dialog's own
   background. Give it an explicit fill. */
QStackedWidget {
    background-color: @BG_WINDOW@;
}

/* Each settings page (GeneralPanel, EmulationPanel, etc.) is itself a bare
   QWidget, so it also gets forced transparent by the rule above -- give
   every direct stackedWidget page an explicit fill too. */
QStackedWidget > QWidget {
    background-color: @BG_WINDOW@;
}

/* ───── Library page ───── */
#libraryPage {
    background-color: @BG_WINDOW@;
}

#libraryHeader {
    background-color: @BG_ALT@;
    border-bottom: 1px solid @BORDER@;
}

#libraryTitle {
    color: @TEXT_BRIGHT@;
    font-size: 13pt;
    font-weight: 600;
    padding: 12px 16px;
}

#librarySearch {
    background-color: @BG_PANEL@;
    border: 1px solid @BORDER@;
    border-radius: 6px;
    padding: 6px 10px;
    color: @TEXT@;
    selection-background-color: @BORDER_LIGHT@;
}

#librarySearch:focus {
    border-color: @ACCENT@;
}

#libraryEmptyTitle {
    color: @TEXT@;
    font-size: 14pt;
    font-weight: 500;
}

#libraryEmptyHint {
    color: @TEXT_MUTED@;
    font-size: 10pt;
}

#libraryDropZone {
    background-color: @BG_PANEL@;
    border: 2px dashed @BORDER_LIGHT@;
    border-radius: 12px;
}

/* ───── Game list ───── */
QTableView#gameTable {
    background-color: @BG_WINDOW@;
    alternate-background-color: @BG_ALT@;
    gridline-color: @BORDER@;
    border: none;
    selection-background-color: @ACCENT_DARK@;
    selection-color: #ffffff;
    outline: 0;
}

QTableView#gameTable::item {
    padding: 6px 8px;
    border: none;
}

QTableView#gameTable::item:hover {
    background-color: @BG_ELEVATED@;
}

QTableView#gameTable::item:selected:hover {
    background-color: @ACCENT_DARK@;
    color: #ffffff;
}

QHeaderView#gameHeader {
    background-color: @BG_PANEL@;
    border: none;
}

QHeaderView#gameHeader::section {
    background-color: @BG_PANEL@;
    color: @TEXT_MUTED@;
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid @BORDER@;
    font-weight: 600;
    font-size: 9pt;
}

QTableCornerButton::section {
    background-color: @BG_PANEL@;
    border: none;
}

/* ───── Generic tables (binding/shortcut tables, etc.) ─────
   Only #gameTable gets bespoke styling above; every other QTableWidget
   (e.g. the controller/shortcut binding tables) has no ::item rule of its
   own, so once any app-wide stylesheet is active Qt's CSS engine stops
   deferring to QPalette for item painting and renders unstyled (black)
   rows unless given an explicit fallback here. */
QTableWidget {
    background-color: @BG_WINDOW@;
    alternate-background-color: @BG_ALT@;
    gridline-color: @BORDER@;
    color: @TEXT@;
    border: 1px solid @BORDER@;
    selection-background-color: @ACCENT_DARK@;
    selection-color: #ffffff;
    outline: 0;
}

QTableWidget::item {
    padding: 4px 8px;
    border: none;
}

QTableWidget::item:selected {
    background-color: @ACCENT_DARK@;
    color: #ffffff;
}

QHeaderView::section {
    background-color: @BG_PANEL@;
    color: @TEXT_MUTED@;
    padding: 6px 8px;
    border: none;
    border-bottom: 1px solid @BORDER@;
    font-weight: 600;
}

QTableCornerButton::section {
    background-color: @BG_PANEL@;
    border: none;
}

/* ───── Status bar ───── */
QStatusBar {
    background-color: @BG_PANEL@;
    color: @TEXT_MUTED@;
    border-top: 1px solid @BORDER@;
}

QStatusBar::item {
    border: none;
}

/* ───── Settings dialog (sidebar) ───── */
QListWidget#panelList {
    background-color: @BG_PANEL@;
    border: none;
    outline: 0;
    padding: 8px 0;
}

QListWidget#panelList::item {
    color: @TEXT_MUTED@;
    padding: 10px 14px;
    border: none;
    border-radius: 6px;
    margin: 2px 8px;
}

QListWidget#panelList::item:hover {
    background-color: @BG_ELEVATED@;
    color: @TEXT_BRIGHT@;
}

QListWidget#panelList::item:selected {
    background-color: @BORDER@;
    color: @TEXT_BRIGHT@;
}

/* ───── Generic controls ───── */
QPushButton {
    background-color: @BG_ELEVATED@;
    border: 1px solid @BORDER@;
    border-radius: 6px;
    padding: 6px 14px;
    color: @TEXT@;
}

QPushButton:hover {
    background-color: @BORDER@;
    color: @TEXT_BRIGHT@;
}

QPushButton:pressed {
    background-color: @BG_ALT@;
}

QPushButton:disabled {
    color: @TEXT_DISABLED@;
    background-color: @BG_ALT@;
    border-color: @BG_ELEVATED@;
}

/* ───── Cheats dialog ───── */
QDialog#cheatsDialog {
    background-color: #17191f;
}

QDialog#cheatsDialog QLabel {
    color: #c8ccd7;
    font-weight: 600;
}

QDialog#cheatsDialog QLineEdit {
    background-color: #101218;
    border: 1px solid #3b414f;
    border-radius: 5px;
    padding: 7px 9px;
    color: #f3f6ff;
    selection-background-color: #3478c7;
}

QDialog#cheatsDialog QLineEdit:focus {
    border-color: @ACCENT_LIGHT@;
    background-color: #151a24;
}

QDialog#cheatsDialog QPushButton {
    min-height: 24px;
    font-weight: 600;
}

QPushButton#cheatAddButton {
    background-color: #2867b2;
    border-color: @ACCENT_LIGHT@;
    color: #ffffff;
}

QPushButton#cheatAddButton:hover {
    background-color: #3478c7;
}

QPushButton#cheatDatabaseButton {
    background-color: #214d78;
    border-color: #3972a8;
    color: #e7f2ff;
}

QPushButton#cheatDatabaseButton:hover {
    background-color: #2b618f;
}

QPushButton#cheatClearButton:hover {
    background-color: #3b4555;
    border-color: #8fa9c9;
    color: #ffffff;
}

QPushButton#cheatRemoveButton:hover,
QPushButton#cheatRemoveAllButton:hover {
    background-color: #582c34;
    border-color: #a84c59;
    color: #ffffff;
}

QDialog#cheatsDialog QTreeWidget {
    background-color: #101218;
    alternate-background-color: #171c26;
    border: 1px solid #3b414f;
    color: #ecf0f8;
    outline: 0;
}

QDialog#cheatsDialog QTreeWidget::item {
    padding: 4px 6px;
}

QDialog#cheatsDialog QTreeWidget::item:hover {
    background-color: #202a3a;
}

QDialog#cheatsDialog QTreeWidget::item:selected {
    background-color: #2867b2;
    color: #ffffff;
}

QDialog#cheatsDialog QHeaderView::section {
    background-color: #242a35;
    border: none;
    border-bottom: 1px solid #4a5364;
    color: #b9d5ff;
    padding: 6px;
    font-weight: 700;
}

QDialog#cheatsDialog QTreeWidget::indicator {
    width: 16px;
    height: 16px;
}

QDialog#cheatsDialog QTreeWidget::indicator:unchecked {
    background-color: #11151d;
    border: 1px solid #67748a;
    border-radius: 3px;
}

QDialog#cheatsDialog QTreeWidget::indicator:checked {
    background-color: #3c91e6;
    border: 1px solid #83c0ff;
    border-radius: 3px;
}

/* Small circular "clear this row's binding" button at the end of each
   binding-table row (ControllerPanel/ShortcutsPanel). The extra bottom
   padding compensates for the "−" glyph sitting at font x-height instead of
   true vertical-center, which otherwise makes it look like an underscore. */
QPushButton#clearBindingButton {
    padding: 0px 0px 3px 0px;
    border-radius: 11px;
    font-weight: bold;
    font-size: 14px;
}

QPushButton#clearBindingButton:hover {
    background-color: #4a2020;
    border-color: #6a2a2a;
    color: #ffffff;
}

QPushButton#clearBindingButton:pressed {
    background-color: #6a2a2a;
}

/* Small circular "reset this row to its default binding" button, next to
   the clear button on the Shortcuts table. */
QPushButton#resetBindingButton {
    padding: 0px 0px 2px 0px;
    border-radius: 11px;
    font-size: 13px;
}

QPushButton#resetBindingButton:hover {
    background-color: #204a3a;
    border-color: #2a6a52;
    color: #ffffff;
}

QPushButton#resetBindingButton:pressed {
    background-color: #2a6a52;
}

QToolTip {
    background-color: @BG_PANEL@;
    color: @TEXT@;
    border: 1px solid @BORDER@;
    padding: 4px 8px;
}

QScrollBar:vertical {
    background-color: @BG_ALT@;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: @BORDER_LIGHT@;
    border-radius: 4px;
    min-height: 30px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background-color: @BORDER_LIGHT@;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    background: none;
    height: 0;
}

QMenu {
    background-color: @BG_PANEL@;
    border: 1px solid @BORDER@;
    color: @TEXT@;
    padding: 4px;
}

QMenu::item {
    padding: 6px 22px;
    border-radius: 4px;
    color: @TEXT@;
}

QMenu::indicator {
    subcontrol-position: right center;
    subcontrol-origin: padding;
    right: 8px;
}

QMenu::indicator:checked {
    image: url(:/icons/@CHECK_ICON@);
    width: 16px;
    height: 16px;
}

QMenu::item:disabled {
    color: @TEXT_DISABLED@;
}

QMenu::item:selected {
    background-color: @BORDER@;
    color: @TEXT_BRIGHT@;
}

QMenu::separator {
    height: 1px;
    margin: 4px 6px;
    background-color: @BORDER_LIGHT@;
}

QMenuBar {
    background-color: @BG_PANEL@;
    color: @TEXT@;
    border-bottom: 1px solid @BORDER@;
}

QMenuBar::item {
    padding: 6px 12px;
    background: transparent;
    color: @TEXT@;
}

QMenuBar::item:selected {
    background-color: @BORDER@;
    color: @TEXT_BRIGHT@;
}

/* ───── Settings panel controls ───── */
QGroupBox {
    background-color: @BG_ELEVATED@;
    color: @TEXT_BRIGHT@;
    border: 1px solid @BORDER@;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 8px;
    padding: 0 4px;
    color: @TEXT_BRIGHT@;
}

QCheckBox {
    color: @TEXT@;
    spacing: 8px;
}

QCheckBox:disabled {
    color: @TEXT_DISABLED@;
    font-style: italic;
}

QCheckBox::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid @BORDER_LIGHT@;
    border-radius: 3px;
    background-color: @BG_PANEL@;
}

QCheckBox::indicator:hover {
    border-color: @ACCENT@;
}

QCheckBox::indicator:checked {
    background-color: @ACCENT@;
    border-color: @ACCENT@;
}

QCheckBox::indicator:disabled {
    border-color: @BORDER@;
    background-color: @BG_ALT@;
}

QComboBox {
    background-color: @BG_ELEVATED@;
    border: 1px solid @BORDER_LIGHT@;
    border-radius: 6px;
    padding: 4px 8px;
    color: @TEXT@;
}

QComboBox:hover {
    border-color: @ACCENT@;
}

QComboBox:disabled {
    color: @TEXT_DISABLED@;
    background-color: @BG_ALT@;
    border-color: @BG_ELEVATED@;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox QAbstractItemView {
    background-color: @BG_PANEL@;
    border: 1px solid @BORDER@;
    color: @TEXT@;
    selection-background-color: @BORDER@;
    selection-color: @TEXT_BRIGHT@;
    outline: none;
}

QLineEdit,
QSpinBox,
QDoubleSpinBox {
    background-color: @BG_ELEVATED@;
    border: 1px solid @BORDER_LIGHT@;
    border-radius: 6px;
    padding: 4px 8px;
    color: @TEXT@;
}

QLineEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: @ACCENT@;
}

QLineEdit:disabled,
QSpinBox:disabled,
QDoubleSpinBox:disabled {
    color: @TEXT_DISABLED@;
    background-color: @BG_ALT@;
    border-color: @BG_ELEVATED@;
}

QSpinBox::up-button,
QSpinBox::down-button,
QDoubleSpinBox::up-button,
QDoubleSpinBox::down-button {
    width: 18px;
    background-color: @BG_ELEVATED@;
    border-left: 1px solid @BORDER_LIGHT@;
    subcontrol-origin: border;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-position: top right;
    border-top-right-radius: 6px;
    border-bottom: 1px solid @BORDER_LIGHT@;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-position: bottom right;
    border-bottom-right-radius: 6px;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::up-button:hover,
QDoubleSpinBox::down-button:hover {
    background-color: @BORDER@;
}

QSpinBox::up-button:pressed,
QSpinBox::down-button:pressed,
QDoubleSpinBox::up-button:pressed,
QDoubleSpinBox::down-button:pressed {
    background-color: @ACCENT@;
}

QSpinBox::up-button:disabled,
QSpinBox::down-button:disabled,
QDoubleSpinBox::up-button:disabled,
QDoubleSpinBox::down-button:disabled {
    background-color: @BG_ELEVATED@;
    border-left-color: @BG_ALT@;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-bottom: 5px solid @TEXT@;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid @TEXT@;
}

QSpinBox::up-arrow:disabled,
QSpinBox::up-arrow:off,
QDoubleSpinBox::up-arrow:disabled,
QDoubleSpinBox::up-arrow:off {
    border-bottom-color: @TEXT_DISABLED@;
}

QSpinBox::down-arrow:disabled,
QSpinBox::down-arrow:off,
QDoubleSpinBox::down-arrow:disabled,
QDoubleSpinBox::down-arrow:off {
    border-top-color: @TEXT_DISABLED@;
}

QSlider::groove:horizontal {
    background-color: @BG_ALT@;
    height: 4px;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background-color: @ACCENT@;
    width: 14px;
    height: 14px;
    margin: -6px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background-color: @ACCENT_LIGHTER@;
}

QSlider::sub-page:horizontal {
    background-color: @ACCENT_DARK@;
    border-radius: 2px;
}
